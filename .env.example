# Pfad zur SQLite-Datei. Im Container setzt das Dockerfile /data/gym.db.
DATABASE_PATH=./data/gym.db

# Optional: Ist der Wert gesetzt, braucht jede Registrierung diesen Code.
# Leer lassen oder weglassen, um die Registrierung offen zu halten.
# REGISTRATION_CODE=

# Zeitzone für die Wochengrenzen in der Statistik.
TZ=Europe/Berlin

# Steuert das "secure"-Flag des Session-Cookies. Ohne Angabe richtet es sich
# nach X-Forwarded-Proto. Auf "true" setzen, wenn dein Reverse Proxy HTTPS
# terminiert, den Header aber nicht mitschickt.
# COOKIE_SECURE=true

# --- E-Mail-Versand (Pflicht) ---------------------------------------------
# Ohne SMTP-Zugangsdaten kann sich niemand registrieren: die Bestätigungsmail
# nach der Registrierung ist Pflicht, ohne sie gibt es keinen Login.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# Absenderadresse inkl. Anzeigename, z. B. "GymTracker <noreply@example.com>"
SMTP_FROM=
# Nur nötig, falls dein Provider auf einem anderen Port als 465 trotzdem
# implizites TLS erwartet. Sonst automatisch aus SMTP_PORT abgeleitet.
# SMTP_SECURE=true

# Basis-URL, unter der GymTracker erreichbar ist – wird für die Links in
# Bestätigungs- und Passwort-Reset-Mails gebraucht (in einer Mail funktioniert
# kein relativer Link). Ohne "/" am Ende.
APP_URL=http://localhost:3000
