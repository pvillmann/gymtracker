# Pfad zur SQLite-Datei. Im Container setzt das Dockerfile /data/gym.db.
DATABASE_PATH=./data/gym.db

# Optional: Ist der Wert gesetzt, braucht jede Registrierung diesen Code.
# Leer lassen oder weglassen, um die Registrierung offen zu halten.
# REGISTRATION_CODE=

# Zeitzone für die Wochengrenzen in der Statistik.
TZ=Europe/Berlin

# Steuert das "secure"-Flag des Session-Cookies. Ohne Angabe richtet es sich
# nach X-Forwarded-Proto. Auf "true" setzen, wenn dein Reverse Proxy HTTPS
# terminiert, den Header aber nicht mitschickt.
# COOKIE_SECURE=true
